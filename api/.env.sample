# POSTGRES DB
# Use your local PostgreSQL role. On macOS this is often your system username,
# not "postgres".
POSTGRES_URL=postgres://YOUR_USER:YOUR_PASSWORD@localhost:5432/onlab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=YOUR_USER
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DATABASE=onlab

# TEST POSTGRES DB
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5432
TEST_POSTGRES_USER=YOUR_USER
TEST_POSTGRES_PASSWORD=YOUR_PASSWORD
TEST_POSTGRES_DATABASE=onlab_test

# Optional test database URL aliases.
# If set, these take precedence in the test datasource helper.
TEST_POSTGRES_URL=postgres://YOUR_USER:YOUR_PASSWORD@localhost:5432/onlab_test
POSTGRES_TEST_URL=postgres://YOUR_USER:YOUR_PASSWORD@localhost:5432/onlab_test

# REST APP URL
PORT=30022
HOST=127.0.0.1
API_HOST=http://localhost:30022
CLIENT_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# FILE UPLOADS
UPLOAD_PATH=uploads/

# REDIS
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# OLLAMA
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
LLM_MODEL=qwen3-coder:30b
OLLAMA_MODEL=mistral
OLLAMA_REQUEST_TIMEOUT_MS=60000
OLLAMA_RETRY_COUNT=1
OLLAMA_RETRY_DELAY_MS=1000
OLLAMA_JSON_REPAIR_RETRY_COUNT=1
OLLAMA_MAX_CONCURRENT_REQUESTS=1

# GITHUB OAUTH APP
GITHUB_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET
GITHUB_CALLBACK_URL=http://localhost:30022/auth/github/callback

# GITHUB APP
GITHUB_APP_ID=YOUR_GITHUB_APP_ID
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=YOUR_GITHUB_WEBHOOK_SECRET
GITHUB_APP_SLUG=YOUR_GITHUB_APP_SLUG
GITHUB_APP_BOT_LOGIN=YOUR_GITHUB_APP_SLUG[bot]
GITHUB_APP_STATE_SECRET=YOUR_LONG_RANDOM_STATE_SECRET

# TEST CONTROLS
RUN_TEST_MIGRATIONS=
SKIP_TEST_MIGRATIONS=
